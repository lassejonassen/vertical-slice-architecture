{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "acme.reader", "description": "Can read clients." },
      { "name": "acme.client-manager", "description": "Can read and manage clients." },
      { "name": "acme.administrator", "description": "Full access." }
    ]
  },
  "clients": [
    {
      "clientId": "acme-api",
      "name": "Acme API (local dev)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "acme-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "reader",
      "enabled": true,
      "firstName": "Reader",
      "lastName": "Dev",
      "email": "reader@acme.test",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
      "realmRoles": ["acme.reader"]
    },
    {
      "username": "client-manager",
      "enabled": true,
      "firstName": "ClientManager",
      "lastName": "Dev",
      "email": "client-manager@acme.test",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "client-manager", "temporary": false }],
      "realmRoles": ["acme.client-manager"]
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "email": "admin@acme.test",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["acme.administrator"]
    }
  ]
}
