{
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionString": "Host=localhost;Port=5432;Database=vertical_slice_architecture;Username=postgres;Password=postgres",
    "MigrateOnStartup": true,
    "EnableSensitiveDataLogging": true
  },

  "Security": {
    "//": "Keycloak locally. Switch Provider to EntraId and fill in Authority/Audience/TenantId for Azure.",
    "Provider": "Keycloak",
    "Authority": "http://localhost:8080/realms/acme",
    "Audience": "acme-api",
    "Realm": "acme",
    "RequireHttpsMetadata": false
  },

  "Observability": {
    "//": "Points at the OTLP collector in docker-compose.yml.",
    "OtlpEndpoint": "http://localhost:4317",
    "UseJsonConsole": false,
    "TraceSampleRatio": 1.0
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
